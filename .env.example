# --- App ---
APP_ENV=dev                      # dev | prod
FRONTEND_URL=http://localhost:5173
# Origens permitidas no CORS (separadas por vírgula). Inclua a URL do túnel ao testar no iPhone.
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# --- Postgres (usado pelo docker-compose) ---
POSTGRES_USER=agenda_local
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=agenda_local
POSTGRES_PORT=5432             # porta publicada no host; troque se já houver Postgres local na 5432
BACKEND_PORT=8000

# --- Banco (o compose sobrescreve o host para "db") ---
DATABASE_URL=postgresql+psycopg://agenda_local:change-me-local-only@localhost:5432/agenda_local

# --- Auth ---
JWT_SECRET=change-me-use-a-random-32-byte-value
JWT_EXPIRES_DAYS=30
MAGIC_LINK_EXPIRES_MIN=15
MAGIC_LINK_RATE_LIMIT_PER_HOUR=3   # em dev, suba para ~20: reinstalar o PWA consome vários links
ALLOWED_EMAILS=                   # vazio em dev; obrigatório em prod, separado por vírgulas
GOOGLE_CLIENT_ID=                 # OAuth Client ID do Google para o login do PWA

# --- Web Push (gerar com: docker compose run --rm backend python -m app.cli vapid) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:voce@exemplo.com

# --- E-mail (fallback de lembrete) ---
# Opção 1: Resend
RESEND_API_KEY=
# Opção 2: SMTP genérico (self-host)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
MAIL_FROM=agenda@exemplo.com

# --- Padrões de usuário ---
DEFAULT_TIMEZONE=America/Sao_Paulo
REMINDER_MAX_ATTEMPTS=3
REMINDER_BATCH_SIZE=50
MAX_ACTIVITY_RANGE_DAYS=366
ACTIVITY_PAGE_SIZE=200
MAX_SUBSCRIPTIONS_PER_USER=50
